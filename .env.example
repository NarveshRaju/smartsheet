# ===========================================
# Smartsheet → Google Calendar Sync
# Environment Variables
# ===========================================

# --- Server ---
PORT=3001
NODE_ENV=development
SESSION_SECRET=generate-a-random-string-here

# --- Database ---
DATABASE_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/smartsheet_gcal_sync?retryWrites=true&w=majority

# --- Encryption ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-char-hex-key-here

# --- Google OAuth 2.0 ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# --- Smartsheet OAuth 2.0 ---
SMARTSHEET_CLIENT_ID=your-smartsheet-client-id
SMARTSHEET_CLIENT_SECRET=your-smartsheet-client-secret
SMARTSHEET_REDIRECT_URI=http://localhost:3001/auth/smartsheet/callback

# --- Frontend ---
FRONTEND_URL=http://localhost:5173

# --- Webhook (use ngrok URL for local dev) ---
WEBHOOK_CALLBACK_URL=https://your-ngrok-url.ngrok.io/webhooks/smartsheet

# --- Timezone ---
DEFAULT_TIMEZONE=Asia/Kolkata

# --- Groq AI Event Curation (Optional) ---
# Get free API key from https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key_here

# --- Automatic sync / AI ---
AUTO_SYNC_INTERVAL_MS=60000
AI_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile
AI_MIN_INTERVAL_MS=10000
# Optional: run Ollama on the same always-on machine as the worker
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# POSTGRES_SOURCE_URL is needed only for an optional import from old Postgres.
