{
  "name": "smartsheet-gcal-sync-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma db push",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "sync:once": "node dist/worker.js",
    "test": "tsx --test test/*.test.ts",
    "db:legacy-client": "prisma generate --schema prisma/legacy-postgres.prisma",
    "db:import-postgres": "node scripts/import-postgres.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.1",
    "@types/node": "^22.10.5",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "googleapis": "^144.0.0",
    "groq-sdk": "^1.5.0",
    "helmet": "^8.0.0",
    "prisma": "^6.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  }
}
